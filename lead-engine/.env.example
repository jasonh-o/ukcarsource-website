# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Custom Search ───────────────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id_here

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=outreach@ukcarsource.com
FROM_NAME=UK Car Source

# ── App ────────────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change_me_to_a_random_string
DATABASE_URL=sqlite:///./lead_engine.db
DEBUG=true

# ── Discovery scheduler (cron) ─────────────────────────────────────────────────
# 24-hour format HH:MM  e.g. 08:00 = 8am
DISCOVERY_RUN_TIME=08:00
DISCOVERY_MAX_RESULTS_PER_QUERY=10

# ── Scraping ────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=Mozilla/5.0 (compatible; UKCarSourceBot/1.0)
