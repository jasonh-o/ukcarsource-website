generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("MEMBER")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id               String    @id @default(cuid())
  companyName      String
  contactName      String?
  country          String
  city             String?
  website          String?
  email            String?
  whatsapp         String?
  phone            String?
  facebookPage     String?
  linkedinPage     String?
  vehicleSpecialty String    @default("[]") // JSON array stored as string
  estimatedSize    String?
  stage            String    @default("NEW")
  score            Int       @default(0)
  tags             String    @default("[]") // JSON array stored as string
  notes            String?
  optedOut         Boolean   @default(false)
  optedOutAt       DateTime?
  source           String    @default("MANUAL")
  assignedToId     String?
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities   Activity[]
  outreachLogs OutreachLog[]
  enquiries    Enquiry[]

  @@index([country, stage])
  @@index([stage])
  @@index([score])
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  note      String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model OutreachLog {
  id         String    @id @default(cuid())
  leadId     String
  channel    String
  subject    String?
  body       String
  status     String    @default("PENDING")
  sentAt     DateTime?
  openedAt   DateTime?
  repliedAt  DateTime?
  messageId  String?
  templateId String?
  createdAt  DateTime  @default(now())
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template   Template? @relation(fields: [templateId], references: [id])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  channel   String
  subject   String?
  body      String
  variables String   @default("[]") // JSON array
  tags      String   @default("[]") // JSON array
  isActive  Boolean  @default(true)
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreachLogs OutreachLog[]
}

model Enquiry {
  id          String    @id @default(cuid())
  leadId      String?
  name        String
  email       String
  company     String?
  country     String?
  message     String
  vehicleType String?
  budget      String?
  status      String    @default("NEW")
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead?     @relation(fields: [leadId], references: [id])
}

model StockAlert {
  id           String   @id @default(cuid())
  email        String
  company      String?
  country      String?
  vehicleTypes String   @default("[]") // JSON array
  makes        String   @default("[]") // JSON array
  priceMax     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}
